    perl-cgi \
    perl-cgi-session \
    perl-class-inspector \
    perl-app-cpanminus \
    perl-crypt-cbc \
    perl-crypt-eksblowfish \
    curl \
    docbook-xsl \
    docbook-xsl-ns \
    expat-dev \
    findutils \
    gawk \
    gettext \
    git \
    grep \
    libxml2 \
    libxml2-utils \
    libxslt \
    libxslt-dev \
    lsb-release \
    mariadb-client \
    memcached \
    musl-locales \
    musl-locales-lang \
    netcat-openbsd \
    nodejs \
    npm \
    openrc \
    perl \
    perl-dev \
    perl-dbd-mysql \
    perl-dbd-sqlite \
    perl-dbi \
    perl-datetime \
    perl-date-calc \
    perl-date-manip \
    perl-datetime-format-builder \
    perl-datetime-format-strptime \
    perl-datetime-timezone \
    perl-doc \
    perl-email-address \
    perl-email-messageid \
    perl-email-mime \
    perl-file-slurp \
    perl-gd \
    perl-html-scrubber \
    perl-json \
    perl-io-socket-ssl \
    perl-libwww \
    perl-list-moreutils \
    perl-locale-gettext \
    perl-log-log4perl \
    perl-mojolicious \
    perl-net-cidr \
    perl-net-idn-encode \
    perl-net-ssleay \
    perl-parallel-forkmanager \
    perl-params-validate \
    perl-sereal-decoder \
    perl-sereal-encoder \
    perl-readonly \
    perl-string-random \
    perl-sub-name \
    perl-template-toolkit \
    perl-text-csv_xs \
    perl-utils \
    perl-xml-libxslt \
    perl-xml-libxml \
    perl-xml-simple \
    perl-yaml-libyaml \
    pwgen \
    rabbitmq-server \
    readline-dev \
    sed \
    shadow \
    sudo \
    ttf-dejavu \
    tzdata \
    unzip \
    wget \
    xmlstarlet \
    busybox-extras

# Build and install YAZ (Z39.50/SRU toolkit) from source on Alpine musl
ENV YAZ_VERSION=5.37.3
RUN wget https://ftp.indexdata.com/pub/yaz/yaz-${YAZ_VERSION}.tar.gz -O /tmp/yaz.tar.gz \
    && tar -xzf /tmp/yaz.tar.gz -C /tmp \
    && cd /tmp/yaz-${YAZ_VERSION} \
    && CFLAGS="-std=gnu17 -Wno-error=implicit-function-declaration -D_GNU_SOURCE" ./configure --prefix=/usr --sysconfdir=/etc \
    && make -j$(nproc) \
    && make install \
    && rm -rf /tmp/yaz*

RUN npm install -g yarn gulp-cli

RUN cpanm --notest Modern::Perl

# CGI::Session md5 ID generation requires Crypt::SysRandom at runtime.
RUN cpanm --notest Crypt::SysRandom

# Alpine 3.24 lacks a packaged Locale::PO required by Koha translator tooling.
RUN cpanm --notest Locale::PO

# Alpine 3.24 lacks a packaged Struct::Diff; install from CPAN for Koha logging.
RUN cpanm --notest Struct::Diff

# Alpine 3.24 lacks a packaged DateTime::Format::MySQL.
RUN cpanm --notest DateTime::Format::MySQL

# Alpine 3.24 lacks a packaged Locale::Currency::Format.
RUN cpanm --notest Locale::Currency::Format

# Alpine 3.24 lacks a packaged Array::Utils.
RUN cpanm --notest Array::Utils

# Alpine 3.24 lacks a packaged MARC::Record.
RUN cpanm --notest MARC::Record

# Alpine 3.24 lacks a packaged MARC::Record::MiJ.
RUN cpanm --notest MARC::Record::MiJ

# Alpine 3.24 lacks a packaged MARC::File::XML.
RUN cpanm --notest MARC::File::XML

# Alpine 3.24 lacks a packaged GD::Barcode.
RUN cpanm --notest GD::Barcode

# Alpine 3.24 lacks a packaged Auth::GoogleAuth.
RUN cpanm --notest Auth::GoogleAuth

# Alpine 3.24 lacks a packaged Number::Format.
RUN cpanm --notest Number::Format

# Alpine 3.24 lacks a packaged Algorithm::Munkres.
RUN cpanm --notest Algorithm::Munkres

# Alpine 3.24 lacks a packaged Net::Stomp.
RUN cpanm --notest Net::Stomp

# Alpine 3.24 lacks a packaged Mojolicious::Plugin::OAuth2.
RUN cpanm --notest Mojolicious::Plugin::OAuth2

# Alpine 3.24 lacks a packaged JSON::Validator.
RUN cpanm --notest JSON::Validator

# Alpine 3.24 lacks a packaged Text::Iconv.
RUN cpanm --notest Text::Iconv

# Alpine 3.24 lacks a packaged Algorithm::CheckDigits.
RUN cpanm --notest Algorithm::CheckDigits

# Alpine package set does not provide Locale::Messages for this image.
RUN cpanm --notest Locale::Messages

# Alpine 3.24 lacks a packaged DBIx::RunSQL.
RUN cpanm --notest DBIx::RunSQL

# Alpine 3.24 lacks a packaged WWW::CSRF.
RUN cpanm --notest WWW::CSRF

# Alpine 3.24 lacks a packaged Mojo::JWT.
RUN cpanm --notest Mojo::JWT

# Alpine 3.24 lacks packaged Email::Stuffer.
RUN cpanm --notest Email::Stuffer

# Alpine 3.24 lacks packaged Lingua::Stem.
RUN cpanm --notest Lingua::Stem

# Alpine 3.24 lacks packaged Lingua::Stem::Snowball.
RUN cpanm --notest Lingua::Stem::Snowball

# Alpine 3.24 lacks a packaged Search::Elasticsearch.
RUN cpanm --notest Search::Elasticsearch

# Alpine 3.24 lacks a packaged DBIx::Class.
RUN cpanm --notest DBIx::Class

# Native compilation of Z39.50/SRU Perl module against compiled YAZ library
RUN cpanm --notest Net::Z3950::ZOOM

# Debian-era Koha staging scripts expect these filesystem targets to exist.
RUN mkdir -p \
    /etc/koha \
    /etc/koha/zebradb \
    /etc/koha/zebradb/marc_defs \
    /etc/default \
    /etc/cron.d \
    /etc/cron.daily \
    /etc/cron.hourly \
    /etc/cron.monthly \
    /etc/bash_completion.d \
    /etc/logrotate.d \
    /etc/apache2/sites-available \
    /etc/apache2/sites-enabled \
    /usr/share/koha/bin \
    /usr/share/koha/intranet/htdocs \
    /usr/share/koha/opac/htdocs \
    /usr/share/man/man8 \
    /usr/share/xml/docbook/stylesheet

# Align Alpine docbook packaging layout with the path expected by cp_debian_files.pl.
RUN if [ -e /usr/share/xml/docbook/xsl-stylesheets-1.79.2/manpages/docbook.xsl ]; then \
        rm -rf /usr/share/xml/docbook/stylesheet/docbook-xsl-ns; \
        ln -s /usr/share/xml/docbook/xsl-stylesheets-1.79.2 /usr/share/xml/docbook/stylesheet/docbook-xsl-ns; \
    fi

# Provide Debian-like Apache helper commands used by Koha scripts.
RUN if [ -f /etc/apache2/httpd.conf ]; then \
        grep -Fqx 'IncludeOptional /etc/apache2/sites-enabled/*.conf' /etc/apache2/httpd.conf \
            || echo 'IncludeOptional /etc/apache2/sites-enabled/*.conf' >> /etc/apache2/httpd.conf; \
        sed -i 's/^#LoadModule rewrite_module modules\/mod_rewrite.so/LoadModule rewrite_module modules\/mod_rewrite.so/' /etc/apache2/httpd.conf; \
        sed -i 's/^#LoadModule cgi_module modules\/mod_cgi.so/LoadModule cgi_module modules\/mod_cgi.so/' /etc/apache2/httpd.conf; \
        sed -i 's/^#LoadModule cgid_module modules\/mod_cgid.so/LoadModule cgid_module modules\/mod_cgid.so/' /etc/apache2/httpd.conf; \
    fi

RUN mkdir -p /lib/lsb
RUN cat >/lib/lsb/init-functions <<'EOF'
#!/bin/sh
log_success_msg() { echo "$*"; }
log_warning_msg() { echo "$*"; }
log_failure_msg() { echo "$*"; }
log_daemon_msg() { echo "$*"; }
log_progress_msg() { echo "$*"; }
log_end_msg() { return 0; }
EOF

RUN chmod 0755 /lib/lsb/init-functions

# Phase 5: Replace the crude /etc/init.d/apache2 shim with a proper OpenRC script,
# and add OpenRC service scripts for koha-plack and koha-worker.
COPY files-alpine/openrc/apache2      /etc/init.d/apache2
COPY files-alpine/openrc/koha-plack   /etc/init.d/koha-plack
COPY files-alpine/openrc/koha-worker  /etc/init.d/koha-worker
RUN chmod 0755 /etc/init.d/apache2 /etc/init.d/koha-plack /etc/init.d/koha-worker \
    && sed -i 's/\r$//' /etc/init.d/apache2 /etc/init.d/koha-plack /etc/init.d/koha-worker

# Phase 5: Alpine periodic cron scripts for Koha scheduled maintenance.
# BusyBox crond reads /etc/crontabs/root which calls run-parts /etc/periodic/*.
RUN mkdir -p /etc/periodic/hourly /etc/periodic/daily /etc/periodic/weekly /etc/periodic/monthly \
    && if ! grep -q 'run-parts' /etc/crontabs/root 2>/dev/null; then \
         printf '# run-parts\n*/15 * * * *\trun-parts /etc/periodic/15min\n0 * * * *\trun-parts /etc/periodic/hourly\n0 2 * * *\trun-parts /etc/periodic/daily\n0 3 * * 0\trun-parts /etc/periodic/weekly\n0 4 1 * *\trun-parts /etc/periodic/monthly\n' \
             >> /etc/crontabs/root; \
       fi
COPY files-alpine/cron/koha-hourly   /etc/periodic/hourly/koha-hourly
COPY files-alpine/cron/koha-daily    /etc/periodic/daily/koha-daily
COPY files-alpine/cron/koha-monthly  /etc/periodic/monthly/koha-monthly
RUN chmod 0755 /etc/periodic/hourly/koha-hourly \
               /etc/periodic/daily/koha-daily \
               /etc/periodic/monthly/koha-monthly \
    && sed -i 's/\r$//' /etc/periodic/hourly/koha-hourly \
                        /etc/periodic/daily/koha-daily \
                        /etc/periodic/monthly/koha-monthly

RUN mkdir -p /kohadevbox
WORKDIR /kohadevbox

COPY files-alpine/run.sh /kohadevbox/
COPY apply-patches.sh /kohadevbox/
COPY patches /kohadevbox/patches
COPY files-alpine/lib /kohadevbox/lib
COPY files-alpine/scripts /kohadevbox/files-alpine/scripts
COPY files-alpine/templates /kohadevbox/templates
COPY files-alpine/git_hooks /kohadevbox/git_hooks
COPY files-alpine/mariadb-ssl /etc/mysql/ssl
COPY env/defaults.env /kohadevbox/templates/defaults.env

# Ensure Linux line endings even when the repository is checked out or edited with CRLF.
RUN sed -i 's/\r$//' /kohadevbox/run.sh \
    && sed -i 's/\r$//' /kohadevbox/apply-patches.sh \
    && find /kohadevbox/templates -type f -exec sed -i 's/\r$//' {} + \
    && find /kohadevbox/files-alpine/scripts -type f -exec sed -i 's/\r$//' {} + \
    && find /kohadevbox/git_hooks -type f -exec sed -i 's/\r$//' {} + \
    && chmod +x /kohadevbox/run.sh /kohadevbox/apply-patches.sh

# Install Alpine-owned admin script overrides ahead of runtime staging.
RUN install -m 0755 /kohadevbox/files-alpine/scripts/koha-create /usr/sbin/koha-create \
    && install -m 0755 /kohadevbox/files-alpine/scripts/koha-plack /usr/sbin/koha-plack \
    && install -m 0755 /kohadevbox/files-alpine/scripts/koha-worker /usr/sbin/koha-worker \
    && install -m 0755 /kohadevbox/files-alpine/scripts/koha-functions.sh /usr/sbin/koha-functions.sh

# Helper repositories used by the Koha development workflow.
RUN cd /kohadevbox \
    && git clone https://gitlab.com/koha-community/koha-misc4dev.git misc4dev \
    && git clone https://gitlab.com/koha-community/qa-test-tools.git qa-test-tools \
    && mkdir -p gitify \
    && printf '#!/bin/sh\n# Phase 3: koha-gitify eliminated; no-op stub\nexit 0\n' > gitify/koha-gitify \
    && chmod 0755 gitify/koha-gitify \
    && chown -R 1000 misc4dev gitify qa-test-tools

# Add the Alpine-specific misc4dev helper without changing the upstream clone layout.
COPY files-alpine/misc4dev/cp_alpine_files.pl /kohadevbox/misc4dev/cp_alpine_files.pl
COPY scripts/build-alpine-package.sh /usr/local/bin/build-alpine-package.sh

RUN chmod +x /kohadevbox/misc4dev/cp_alpine_files.pl /usr/local/bin/build-alpine-package.sh

EXPOSE 6001 8080 8081

CMD ["/bin/bash", "/kohadevbox/run.sh"]

# dev-runtime: thin wrapper that declares the koha source volume for bind-mount at runtime.
FROM koha-base AS dev-runtime
VOLUME /kohadevbox/koha

FROM koha-base AS prod-runtime

ARG KOHA_GIT_URL=https://git.koha-community.org/Koha-community/Koha.git
ARG KOHA_GIT_REF=v25.11.05-1
ARG KOHA_GIT_DEPTH=1
ARG KOHA_VERSION=25.11.05-1

LABEL org.opencontainers.image.title="koha-alpine-prod" \
      org.opencontainers.image.version="${KOHA_VERSION}" \
      org.opencontainers.image.source="${KOHA_GIT_URL}"

# Bake a fixed Koha source tree in-image for production runs.
RUN rm -rf /kohadevbox/koha \
    && mkdir -p /kohadevbox/koha \
    && git -C /kohadevbox/koha init \
    && git -C /kohadevbox/koha remote add origin "${KOHA_GIT_URL}" \
    && git -C /kohadevbox/koha fetch --depth "${KOHA_GIT_DEPTH}" origin "${KOHA_GIT_REF}" \
    && git -C /kohadevbox/koha checkout --detach FETCH_HEAD

# Pre-install JS dependencies at build time to reduce runtime startup cost.
RUN cd /kohadevbox/koha \
    && yarn install --frozen-lockfile

# Perform build-time asset staging for immutable production image
RUN /usr/local/bin/build-alpine-package.sh /kohadevbox/koha

# Re-apply Alpine overrides after Debian script staging in production image.
RUN install -m 0755 /kohadevbox/files-alpine/scripts/koha-create /usr/sbin/koha-create \
    && install -m 0755 /kohadevbox/files-alpine/scripts/koha-plack /usr/sbin/koha-plack \
    && install -m 0755 /kohadevbox/files-alpine/scripts/koha-worker /usr/sbin/koha-worker \
    && install -m 0755 /kohadevbox/files-alpine/scripts/koha-functions.sh /usr/sbin/koha-functions.sh

ENV SKIP_RUNTIME_ASSET_COPY=yes
ENV SKIP_YARN_INSTALL=yes