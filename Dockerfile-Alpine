FROM alpine:3.24.1 AS koha-base

# File Author / Maintainer
LABEL maintainer="kosson@gmail.com"

ENV PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV REFRESHED_AT=2026-07-22T18:20:00Z14

# Alpine base packages for a Koha-oriented runtime and build environment.
RUN apk add --no-cache \
    apache2 \
    apache2-utils \
    bash \
    bash-completion \
    build-base \
    perl-bytes-random-secure \
    coreutils \
    perl-business-isbn \
    perl-business-issn \
