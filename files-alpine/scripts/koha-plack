#!/bin/sh
# Alpine-native koha-plack implementation (first cut).
# Scope: --enable/--disable/--start/--stop/--restart/--reload/--status

set -eu

[ -r /etc/default/koha-common ] && . /etc/default/koha-common

if [ -f /usr/sbin/koha-functions.sh ]; then
    . /usr/sbin/koha-functions.sh
elif [ -f /usr/share/koha/bin/koha-functions.sh ]; then
    . /usr/share/koha/bin/koha-functions.sh
else
    echo "[koha-plack-alpine] ERROR: /usr/share/koha/bin/koha-functions.sh not present" >&2
    exit 1
fi

log_info() { echo "[koha-plack-alpine] $*"; }
log_warn() { echo "[koha-plack-alpine] WARNING: $*" >&2; }
log_err() { echo "[koha-plack-alpine] ERROR: $*" >&2; }
die_msg() { log_err "$*"; exit 1; }

usage() {
    local scriptname
    scriptname=$(basename "$0")
    cat <<EOF
$scriptname

Manage plack daemons for Koha instances (Alpine rewrite).

Usage:
  $scriptname --start|--stop|--restart|--reload|--status|--development [--quiet|-q] instancename1 [instancename2...]
  $scriptname --enable|--disable [--quiet|-q] instancename1 [instancename2...]
  $scriptname -h|--help

Supported options:
  --start
  --stop
  --restart
  --reload
  --enable
  --disable
  --status
  --debugger
  --debugger-key <key>
  --debugger-location <host:port>
  --debugger-path <path>
  -dev|--development
  -q|--quiet
  -h|--help
EOF
}

op=""
quiet="no"
debugger="no"
debugger_key=""
debugger_location="localhost:9000"
debugger_path=""
development_environment=""
starman_bin="$(command -v starman || true)"

set_action() {
    if [ -z "$op" ]; then
        op="$1"
    else
        die_msg "only one action can be specified"
    fi
}

set_help_flag() {
    start_stop_help="$(start-stop-daemon --help 2>&1 || true)"
    case "$start_stop_help" in
        *"--retry"*|*"-R"*) ssd_has_retry=yes ;;
        *) ssd_has_retry=no ;;
    esac
}

is_plack_running_alpine() {
    instancename="$1"
    pidfile="/var/run/koha/${instancename}/plack.pid"

    if [ ! -s "$pidfile" ]; then
        return 1
    fi

    pid="$(cat "$pidfile" 2>/dev/null || true)"
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac

    if kill -0 "$pid" 2>/dev/null; then
        return 0
    fi

    return 1
}

ensure_plack_logs() {
    instancename="$1"
    for file in \
        "/var/log/koha/${instancename}/plack.log" \
        "/var/log/koha/${instancename}/plack-error.log"; do
        [ -e "$file" ] || touch "$file"
        chown "${instancename}-koha:${instancename}-koha" "$file"
    done
}

plack_value() {
    instancename="$1"
    key="$2"
    if command -v run_safe_xmlstarlet >/dev/null 2>&1; then
        run_safe_xmlstarlet "$instancename" "$key" 2>/dev/null || true
    fi
}

enable_plack() {
    instancename="$1"
    instancefile="$(get_apache_config_for "$instancename")"

    [ -n "$instancefile" ] || {
        [ "$quiet" != "yes" ] && log_warn "No apache config found for ${instancename}"
        return 1
    }

    alreadyopac=0
    alreadyintra=0
    failopac=0
    failintra=0

    if ! is_plack_enabled_opac "$instancefile"; then
        sed -i 's:^\s*#\(\s*Include /etc/koha/apache-shared-opac-plack.conf\)$:\1:' "$instancefile"
        if ! is_plack_enabled_opac "$instancefile"; then
            [ "$quiet" != "yes" ] && log_warn "Plack not enabled for ${instancename} OPAC"
            failopac=1
        fi
    else
        [ "$quiet" != "yes" ] && log_warn "Plack already enabled for ${instancename} OPAC"
        alreadyopac=1
    fi

    if ! is_plack_enabled_intranet "$instancefile"; then
        sed -i 's:^\s*#\(\s*Include /etc/koha/apache-shared-intranet-plack.conf\)$:\1:' "$instancefile"
        if ! is_plack_enabled_intranet "$instancefile"; then
            [ "$quiet" != "yes" ] && log_warn "Plack not enabled for ${instancename} Intranet"
            failintra=1
        fi
    else
        [ "$quiet" != "yes" ] && log_warn "Plack already enabled for ${instancename} Intranet"
        alreadyintra=1
    fi

    if [ "$alreadyopac" -eq 1 ] && [ "$alreadyintra" -eq 1 ]; then
        return 1
    fi

    if [ "$alreadyopac" != "$alreadyintra" ]; then
        [ "$quiet" != "yes" ] && log_warn "${instancename} had a plack configuration mismatch; please verify config"
    fi

    if [ "$failopac" -eq 0 ] || [ "$failintra" -eq 0 ]; then
        return 0
    fi

    return 1
}

disable_plack() {
    instancename="$1"
    instancefile="$(get_apache_config_for "$instancename")"

    [ -n "$instancefile" ] || {
        [ "$quiet" != "yes" ] && log_warn "No apache config found for ${instancename}"
        return 1
    }

    alreadyopac=0
    alreadyintra=0
    failopac=0
    failintra=0

    if is_plack_enabled_opac "$instancefile"; then
        sed -i 's:^\(\s*Include /etc/koha/apache-shared-opac-plack.conf\)$:#\1:' "$instancefile"
        if is_plack_enabled_opac "$instancefile"; then
            [ "$quiet" != "yes" ] && log_warn "Plack not disabled for ${instancename} OPAC"
            failopac=1
        fi
    else
        [ "$quiet" != "yes" ] && log_warn "Plack already disabled for ${instancename} OPAC"
        alreadyopac=1
    fi

    if is_plack_enabled_intranet "$instancefile"; then
        sed -i 's:^\(\s*Include /etc/koha/apache-shared-intranet-plack.conf\)$:#\1:' "$instancefile"
        if is_plack_enabled_intranet "$instancefile"; then
            [ "$quiet" != "yes" ] && log_warn "Plack not disabled for ${instancename} Intranet"
            failintra=1
        fi
    else
        [ "$quiet" != "yes" ] && log_warn "Plack already disabled for ${instancename} Intranet"
        alreadyintra=1
    fi

    if [ "$alreadyopac" -eq 1 ] && [ "$alreadyintra" -eq 1 ]; then
        return 1
    fi

    if [ "$alreadyopac" != "$alreadyintra" ]; then
        [ "$quiet" != "yes" ] && log_warn "${instancename} had a plack configuration mismatch; please verify config"
    fi

    if [ "$failopac" -eq 0 ] || [ "$failintra" -eq 0 ]; then
        return 0
    fi

    return 1
}

start_plack() {
    instancename="$1"

    [ -n "$starman_bin" ] || {
        log_err "starman binary not found"
        return 1
    }

    pidfile="/var/run/koha/${instancename}/plack.pid"
    placksocket="/var/run/koha/${instancename}/plack.sock"
    psgifile="/etc/koha/plack.psgi"
    instance_user="${instancename}-koha"
    instance_home="/var/lib/koha/${instancename}"

    if [ -e "/etc/koha/sites/${instancename}/plack.psgi" ]; then
        psgifile="/etc/koha/sites/${instancename}/plack.psgi"
    fi

    if command -v getent >/dev/null 2>&1; then
        resolved_home="$(getent passwd "$instance_user" | cut -d: -f6 || true)"
        [ -n "$resolved_home" ] && instance_home="$resolved_home"
    fi

    ensure_plack_logs "$instancename"

    plack_max_requests="$(plack_value "$instancename" plack_max_requests)"
    [ -n "$plack_max_requests" ] || plack_max_requests="50"
    plack_workers="$(plack_value "$instancename" plack_workers)"
    [ -n "$plack_workers" ] || plack_workers="2"

    if is_debug_mode "$instancename" || [ -n "$development_environment" ]; then
        environment="development"
    else
        environment="deployment"
    fi

    daemonize="--daemonize"
    access_log="/var/log/koha/${instancename}/plack.log"
    error_log="/var/log/koha/${instancename}/plack-error.log"

    if [ "$debugger" = "yes" ] && [ "$environment" = "development" ]; then
        daemonize=""
        plack_workers="1"
        if [ -n "$debugger_path" ]; then
            PERL5LIB="${debugger_path}:${PERL5LIB:-}"
            export PERL5LIB
        fi
        export PERL5DB="BEGIN { require q(${debugger_path}/perl5db.pl) }"
        export PERLDB_OPTS="RemotePort=${debugger_location} async=1 LogFile=/var/log/koha/${instancename}/plack-debug.log"
        export DBGP_IDEKEY="$debugger_key"
        export PLACK_DEBUG=1
        export PERL5OPT="-d"
    fi

    if is_plack_running_alpine "$instancename"; then
        [ "$quiet" != "yes" ] && log_warn "Plack already running for ${instancename}"
        return 1
    fi

    log_info "Starting Plack daemon for ${instancename}"
    export KOHA_CONF="/etc/koha/sites/${instancename}/koha-conf.xml"

    mkdir -p "$(dirname "$pidfile")"
    if [ "$debugger" = "yes" ] && [ "$environment" = "development" ]; then
        (
            cd "$instance_home"
            exec /usr/bin/perl -d "$starman_bin" -M FindBin \
                --max-requests "$plack_max_requests" \
                --workers "$plack_workers" \
                --user "$instance_user" \
                --group "$instance_user" \
                --pid "$pidfile" \
                -E "$environment" \
                --socket "$placksocket" \
                "$psgifile"
        )
    else
        (
            cd "$instance_home"
            exec "$starman_bin" -M FindBin \
                --max-requests "$plack_max_requests" \
                --workers "$plack_workers" \
                --user "$instance_user" \
                --group "$instance_user" \
                --pid "$pidfile" \
                $daemonize \
                --access-log "$access_log" \
                --error-log "$error_log" \
                -E "$environment" \
                --socket "$placksocket" \
                "$psgifile"
        )
    fi
}

stop_plack() {
    instancename="$1"
    pidfile="/var/run/koha/${instancename}/plack.pid"
    instance_user="${instancename}-koha"

    if ! is_plack_running_alpine "$instancename"; then
        [ "$quiet" != "yes" ] && log_warn "Plack not running for ${instancename}"
        return 1
    fi

    log_info "Stopping Plack daemon for ${instancename}"

    if command -v start-stop-daemon >/dev/null 2>&1; then
        if [ "${ssd_has_retry:-no}" = "yes" ]; then
            if start-stop-daemon --stop --pidfile "$pidfile" --user "$instance_user" --retry 5 >/dev/null 2>&1; then
                rm -f "$pidfile"
                return 0
            fi
        elif start-stop-daemon --stop --pidfile "$pidfile" --user "$instance_user" >/dev/null 2>&1; then
            rm -f "$pidfile"
            return 0
        fi
    fi

    pid="$(cat "$pidfile" 2>/dev/null || true)"
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac

    kill "$pid" >/dev/null 2>&1 || true
    i=0
    while [ "$i" -lt 30 ]; do
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$pidfile"
            return 0
        fi
        i=$((i + 1))
        sleep 1
    done

    kill -KILL "$pid" >/dev/null 2>&1 || true
    rm -f "$pidfile"
    return 0
}

reload_plack() {
    instancename="$1"
    pidfile="/var/run/koha/${instancename}/plack.pid"

    if ! is_plack_running_alpine "$instancename"; then
        [ "$quiet" != "yes" ] && log_warn "Plack not running for ${instancename}"
        return 1
    fi

    if command -v start-stop-daemon >/dev/null 2>&1; then
        if start-stop-daemon --stop --pidfile "$pidfile" --signal HUP >/dev/null 2>&1; then
            return 0
        fi
    fi

    pid="$(cat "$pidfile" 2>/dev/null || true)"
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac

    kill -HUP "$pid"
}

plack_status() {
    instancename="$1"
    if is_plack_running_alpine "$instancename"; then
        [ "$quiet" != "yes" ] && log_info "Plack running for ${instancename}"
        return 0
    fi

    [ "$quiet" != "yes" ] && log_info "Plack not running for ${instancename}"
    return 3
}

check_env_and_warn() {
    missing_modules=""
    required_modules="headers proxy_http"

    if command -v apache2ctl >/dev/null 2>&1; then
        if ! apache2ctl -v 2>/dev/null | grep -q "Server version: Apache/2.4"; then
            log_warn "koha-plack expects Apache 2.4.x"
        fi
    fi

    if command -v apachectl >/dev/null 2>&1; then
        for module in $required_modules; do
            if ! apachectl -M 2>/dev/null | grep -q "$module"; then
                missing_modules="${missing_modules}${module} "
            fi
        done
    fi

    if [ -n "$missing_modules" ]; then
        log_warn "missing Apache modules: ${missing_modules}(load them in image build config; no runtime Debian module-enable helper on Alpine)"
    fi
}

do_instance() {
    name="$1"

    adjust_paths_git_install "$name"
    PERL5LIB="${PERL5LIB:-}:$KOHA_HOME/installer:$KOHA_HOME/lib/installer"
    if [ "$KOHA_BINDIR" = "misc" ]; then
        GIT_INSTALL=1
    else
        GIT_INSTALL=""
    fi
    export PERL5LIB KOHA_HOME GIT_INSTALL

    case "$op" in
        start) start_plack "$name" ;;
        stop) stop_plack "$name" ;;
        restart) stop_plack "$name" && start_plack "$name" ;;
        reload) reload_plack "$name" ;;
        enable) enable_plack "$name" ;;
        disable) disable_plack "$name" ;;
        status) plack_status "$name" ;;
        *) usage ; exit 1 ;;
    esac
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -q|--quiet)
            quiet="yes"
            shift
            ;;
        --start)
            set_action start
            shift
            ;;
        --stop)
            set_action stop
            shift
            ;;
        --restart)
            set_action restart
            shift
            ;;
        --reload)
            set_action reload
            shift
            ;;
        --enable)
            set_action enable
            shift
            ;;
        --disable)
            set_action disable
            shift
            ;;
        --status)
            set_action status
            shift
            ;;
        --debugger)
            debugger="yes"
            shift
            ;;
        --debugger-key)
            debugger_key="$2"
            shift 2
            ;;
        --debugger-location)
            debugger_location="$2"
            shift 2
            ;;
        --debugger-path)
            debugger_path="$2"
            shift 2
            ;;
        -dev|--development)
            development_environment=1
            shift
            ;;
        -*)
            die_msg "invalid option switch ($1)"
            ;;
        *)
            break
            ;;
    esac
done

[ -n "$op" ] || die_msg "missing action"

[ "$quiet" = "yes" ] || check_env_and_warn
set_help_flag

if [ "$#" -le 0 ]; then
    [ "$quiet" != "yes" ] && log_warn "you must provide at least one instance name"
    exit 1
fi

rc=0
for name in "$@"; do
    if is_instance "$name"; then
        if ! do_instance "$name"; then
            rc=1
        fi
    else
        if [ "$quiet" = "no" ]; then
            log_err "Invalid instance name $name"
            rc=1
        fi
    fi
done

exit "$rc"
