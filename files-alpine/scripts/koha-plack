#!/bin/bash
# koha-plack Alpine - v10 - perl + log path fix
set -e
INSTANCE="${2:-${1:-kohadev}}"
if [ "$1" = "--enable" ] || [ "$1" = "--disable" ]; then INSTANCE="${2:-kohadev}"; fi
if [ "$1" = "--start" ] || [ "$1" = "--stop" ] || [ "$1" = "--restart" ] || [ "$1" = "--status" ]; then INSTANCE="${2:-kohadev}"; fi

KOHA_PATH="${KOHA_PATH:-/kohadevbox/koha}"
PERL5LIB_PATH="/opt/koha-perl/lib/perl5:${KOHA_PATH}/lib:${KOHA_PATH}"
PLACKUP="/opt/koha-perl/bin/plackup"
APP_PSGI="${KOHA_PATH}/app.psgi"
LOG_DIR="/var/log/koha/${INSTANCE}"
RUN_DIR="/var/run/koha/${INSTANCE}"
PIDFILE="${RUN_DIR}/plack.pid"
ERROR_LOG="${LOG_DIR}/plack-error.log"
ACCESS_LOG="${LOG_DIR}/plack.log"

mkdir -p "$LOG_DIR" "$RUN_DIR"
chown -R kohadev:kohadev /var/log/koha /var/run/koha 2>/dev/null || true
touch "$ERROR_LOG" "$ACCESS_LOG"
chown kohadev:kohadev "$ERROR_LOG" "$ACCESS_LOG" 2>/dev/null || true

case "$1" in
  --enable)
    mkdir -p /etc/koha/sites-enabled
    touch "/etc/koha/sites/${INSTANCE}/plack_enabled" 2>/dev/null || true
    echo "[plack] Enabled"
    exit 0
    ;;
  --disable)
    rm -f "/etc/koha/sites/${INSTANCE}/plack_enabled"
    echo "[plack] Disabled"
    exit 0
    ;;
  --status)
    if [ -f "$PIDFILE" ]; then
      pid=$(cat "$PIDFILE")
      if kill -0 "$pid" 2>/dev/null; then
        echo "[plack] running pid=$pid"
        exit 0
      fi
    fi
    # also check via pgrep
    if pgrep -f "plackup.*${INSTANCE}" >/dev/null 2>&1 || pgrep -f "app.psgi" >/dev/null 2>&1; then
      echo "[plack] running (pgrep)"
      exit 0
    fi
    echo "[plack] not running"
    exit 1
    ;;
  --start)
    echo "[plack] Starting $APP_PSGI on :5000 with /usr/bin/perl $PLACKUP"
    if [ ! -f "$APP_PSGI" ]; then echo "[plack] $APP_PSGI not found"; exit 1; fi
    PERL5LIB="$PERL5LIB_PATH" /usr/bin/perl -c "$APP_PSGI" 2>&1 | head -5 || true
    echo "/kohadevbox/koha/app.psgi syntax OK"
    # start daemon
    rm -f "$PIDFILE"
    PERL5LIB="$PERL5LIB_PATH" /usr/bin/perl "$PLACKUP" \
      --server Starman \
      --port 5000 \
      --host 0.0.0.0 \
      --pid "$PIDFILE" \
      --error-log "$ERROR_LOG" \
      --access-log "$ACCESS_LOG" \
      -D \
      "$APP_PSGI" 2>>"$ERROR_LOG" || {
        # fallback try without Starman
        PERL5LIB="$PERL5LIB_PATH" /usr/bin/perl "$PLACKUP" \
          --port 5000 --host 0.0.0.0 --pid "$PIDFILE" -D "$APP_PSGI" 2>>"$ERROR_LOG" || true
      }
    sleep 2
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      echo "[plack] Started pid=$(cat "$PIDFILE")"
      exit 0
    else
      echo "[plack] FAILED to start - see $ERROR_LOG"
      cat "$ERROR_LOG" | tail -30
      exit 1
    fi
    ;;
  --stop)
    if [ -f "$PIDFILE" ]; then kill "$(cat "$PIDFILE")" 2>/dev/null || true; rm -f "$PIDFILE"; fi
    pkill -f "plackup.*$INSTANCE" 2>/dev/null || true
    pkill -f "app.psgi" 2>/dev/null || true
    echo "[plack] stopped"
    exit 0
    ;;
  --restart)
    $0 --stop "$INSTANCE"
    sleep 1
    $0 --start "$INSTANCE"
    ;;
  *)
    echo "Usage: $0 --enable|--disable|--start|--stop|--restart|--status [instance]"
    exit 1
    ;;
esac
