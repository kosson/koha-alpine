#!/bin/bash
# koha-worker Alpine - v10 - compat with Koha 25.11 (background_jobs_worker.pl may not exist)
set -e
INSTANCE="${2:-${1:-kohadev}}"
if [ "$1" = "--enable" ] || [ "$1" = "--disable" ]; then INSTANCE="${2:-kohadev}"; fi
if [ "$1" = "--start" ] || [ "$1" = "--stop" ] || [ "$1" = "--restart" ] || [ "$1" = "--status" ]; then INSTANCE="${2:-kohadev}"; fi

KOHA_PATH="${KOHA_PATH:-/kohadevbox/koha}"
PERL5LIB_PATH="/opt/koha-perl/lib/perl5:${KOHA_PATH}/lib:${KOHA_PATH}"
RUN_DIR="/var/run/koha/${INSTANCE}"
LOG_DIR="/var/log/koha/${INSTANCE}"
PIDFILE="${RUN_DIR}/worker.pid"
WORKER_LOG="${LOG_DIR}/worker.log"

mkdir -p "$RUN_DIR" "$LOG_DIR"
chown -R kohadev:kohadev /var/log/koha /var/run/koha 2>/dev/null || true
touch "$WORKER_LOG"
chown kohadev:kohadev "$WORKER_LOG" 2>/dev/null || true

# Find worker script - multiple possible locations across Koha versions
find_worker(){
  for f in \
    "$KOHA_PATH/misc/background_jobs_worker.pl" \
    "$KOHA_PATH/bin/background_jobs_worker.pl" \
    "$KOHA_PATH/misc/worker.pl" \
    "$KOHA_PATH/bin/worker.pl" \
    "$KOHA_PATH/misc/background_jobs/background_jobs_worker.pl" \
    "$KOHA_PATH/admin/background_jobs.pl"; do
    [ -f "$f" ] && echo "$f" && return 0
  done
  return 1
}

case "$1" in
  --enable)
    echo "[worker] --enable noop on Alpine (always enabled via file flag)"
    mkdir -p "/etc/koha/sites/${INSTANCE}"
    touch "/etc/koha/sites/${INSTANCE}/worker_enabled" 2>/dev/null || true
    exit 0
    ;;
  --disable)
    rm -f "/etc/koha/sites/${INSTANCE}/worker_enabled"
    exit 0
    ;;
  --status)
    if [ -f "$PIDFILE" ]; then
      pid=$(cat "$PIDFILE")
      if kill -0 "$pid" 2>/dev/null; then echo "[worker] running pid=$pid"; exit 0; fi
    fi
    # If no real worker exists in this Koha version, consider it OK (dummy)
    if ! find_worker >/dev/null 2>&1; then
      echo "[worker] No worker script found, considering up (compat mode)"
      exit 0
    fi
    if pgrep -f "background_jobs" >/dev/null 2>&1; then echo "[worker] running (pgrep)"; exit 0; fi
    echo "[worker] not running"
    exit 1
    ;;
  --start)
    WORKER=$(find_worker || true)
    if [ -z "$WORKER" ]; then
      echo "[worker] No worker script found, skipping dummy"
      echo $$ > "$PIDFILE"
      echo "[worker] dummy pid $$ started (compat for Koha $(grep -m1 VERSION $KOHA_PATH/Koha.pm 2>/dev/null || echo 'unknown'))"
      exit 0
    fi
    echo "[worker] Starting $WORKER for $INSTANCE"
    rm -f "$PIDFILE"
    PERL5LIB="$PERL5LIB_PATH" /usr/bin/perl "$WORKER" --instance "$INSTANCE" >>"$WORKER_LOG" 2>&1 &
    echo $! > "$PIDFILE"
    sleep 1
    if kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then echo "[worker] started pid=$(cat "$PIDFILE")"; exit 0; else echo "[worker] failed"; cat "$WORKER_LOG" | tail -20; exit 1; fi
    ;;
  --stop)
    if [ -f "$PIDFILE" ]; then kill "$(cat "$PIDFILE")" 2>/dev/null || true; rm -f "$PIDFILE"; fi
    pkill -f "background_jobs_worker" 2>/dev/null || true
    echo "[worker] stopped"
    exit 0
    ;;
  --restart)
    $0 --stop "$INSTANCE"
    sleep 1
    $0 --start "$INSTANCE"
    ;;
  *)
    echo "Usage: $0 --enable|--disable|--start|--stop|--restart|--status [instance]"
    exit 1
    ;;
esac
