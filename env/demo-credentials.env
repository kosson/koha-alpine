# PUBLIC DEMO CREDENTIALS - for local test sessions only. NOT SECRETS.
# Copy these values into your own env file (replace the blank lines of the same
# names in env/.env). Production mode (--image-mode prod) refuses any password
# starting with "demo-" unless KOHA_ALLOW_DEMO_CREDENTIALS=yes is set.
KOHA_DB_ROOT_PASSWORD=demo-root-password
KOHA_DB_PASSWORD=demo-db-password
KOHA_RABBITMQ_PASS=demo-rabbitmq-password
KOHA_PASS=demo-koha-password
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Demo-Opensearch-1-Password
