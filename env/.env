KOHA_OPAC_PORT=8080
KOHA_INTRANET_PREFIX=
KOHA_INTRANET_SUFFIX=-intra
KOHA_OPAC_PREFIX=
KOHA_OPAC_SUFFIX=
KOHA_MARC_FLAVOUR=marc21
KOHA_PUBLIC_PORT=80
KOHA_PASS=koha
KOHA_USER=kohadev
MANA_URL=https://mana-test.koha-community.org
PERL5LIB=/kohadevbox/koha:/kohadevbox/koha/lib:/kohadevbox/qa-test-tools
REMOTE_DEBUGGER_KEY=
REMOTE_DEBUGGER_LOCATION=host.docker.internal:9000
SELENIUM_ADDR=selenium
SELENIUM_PORT=4444
KOHA_ELASTICSEARCH=yes
SEARCH_ENGINE=Elasticsearch
ELASTICSEARCH_SERVER=os01:9200
ELASTIC_SERVER=https://os01:9200
ELASTIC_OPTIONS=<ssl_options><SSL_verify_mode>0</SSL_verify_mode></ssl_options><userinfo>admin:test@Cici24#ANA</userinfo><client_version>7</client_version>
PERL_LWP_SSL_VERIFY_HOSTNAME=0
OPENSEARCH_INITIAL_ADMIN_PASSWORD=test@Cici24#ANA
KOHA_ALPINE_SKIP_YARN_INSTALL=yes
KOHA_ALPINE_SKIP_GIT_SETUP=yes
KOHA_ALPINE_SKIP_L10N=yes
KOHA_ALPINE_SKIP_ELASTICSEARCH_WAIT=yes
SKIP_RUNTIME_ASSET_COPY=yes
KOHA_ALPINE_SKIP_RUNTIME_COPY=yes
KOHA_ALPINE_SKIP_DEBIAN_SCRIPTS=yes
KOHA_LLAMA_URL=http://llama:8080
KOHA_ALPINE_SKIP_YARN_INSTALL=yes
KOHA_ALPINE_ENABLE_CROND=yes
CI_RUN=no
CPAN=no
INSTALL_MISSING_FROM_CPANFILE=no
KEYCLOAK_ADMIN=keycloak
KEYCLOAK_ADMIN_PASS=keycloak
KEYCLOAK_REALM=koha
USE_EXISTING_DB=yes
LOAD_DEMO_DATA=yes
KOHA_DESIRED_LANGUAGES=en,es-ES,ro-RO,ca-ES,hu-HU,de-DE
KOHA_OPAC_LANGUAGES_DISPLAY=1
KOHA_TRANSLATIONS_REINSTALL=no
PLACK_MAX_REQUESTS=50
PLACK_WORKERS=2
KOHA_DB_TLS_CLIENT_CERTIFICATE=/etc/mysql/ssl/client-cert.pem
KOHA_DB_TLS_CLIENT_KEY=/etc/mysql/ssl/client-key.pem