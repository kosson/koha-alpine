##############################################################################
# KOHA - ALPINE LINUX - FULL BEEFY VERSION
# Alpine 3.20, Perl 5.38, Koha main
# Fixes: uses /usr/bin/perl explicitly, no quote hell in run.sh
##############################################################################
FROM alpine:3.20 AS base

LABEL maintainer="Constantinescu Nicolaie <kosson>" \
      description="Koha ILS on Alpine Linux - optimized"

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    KOHASITE=kohadev \
    KOHA_USER=kohadev \
    KOHA_GROUP=kohadev \
    KOHA_HOME=/var/lib/koha \
    KOHADEVBOX=/kohadevbox/koha \
    PERL_LOCAL_LIB_ROOT=/opt/koha-perl \
    PERL_MB_OPT="--install_base /opt/koha-perl" \
    PERL_MM_OPT="INSTALL_BASE=/opt/koha-perl" \
    PERL5LIB=/opt/koha-perl/lib/perl5:/kohadevbox/koha/lib:/kohadevbox/koha \
    PATH=/opt/koha-perl/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    TIMEZONE=Europe/Bucharest \
    KOHA_PLACK_PORT=5000 \
    ELASTICSEARCH_HOST=elasticsearch \
    MEMCACHED_HOST=memcached

# ---------------------------------------------------------------------------
# 1. SYSTEM DEPENDENCIES - translated from Debian koha dependencies
# ---------------------------------------------------------------------------
RUN apk add --no-cache \
    # Base
    bash perl perl-dev perl-utils perl-app-cpanminus \
    ca-certificates curl wget git procps net-tools libcap shadow \
    tzdata tini \
    # Build tools - needed for XS modules
    build-base make gcc g++ musl-dev pkgconfig \
    autoconf automake libtool \
    # Koha system deps
    mariadb-client mariadb-connector-c-dev \
    yaz yaz-dev libyaz \
    libxml2 libxml2-dev libxslt libxslt-dev \
    libexpat expat-dev \
    icu icu-dev icu-data-full \
    libjpeg-turbo libjpeg-turbo-dev \
    libpng libpng-dev \
    libwebp libwebp-dev \
    libzip libzip-dev \
    zlib zlib-dev \
    openldap openldap-dev \
    openssl openssl-dev \
    gd gd-dev \
    freetype freetype-dev \
    libxslt \
    poppler-utils \
    ghostscript \
    # For PDF and printing
    wkhtmltopdf \
    # Node for asset building (Koha uses webpack)
    nodejs npm yarn \
    # Perl core modules that Alpine splits
    perl-json perl-yaml perl-libwww perl-dbi perl-dbd-mysql \
    perl-cgi perl-digest-sha perl-encode \
    # Utilities
    rsync unzip zip file which sudo

# ---------------------------------------------------------------------------
# 2. CREATE KOHA USER AND DIRECTORIES
# ---------------------------------------------------------------------------
RUN addgroup -S ${KOHA_GROUP} && \
    adduser -D -h ${KOHA_HOME} -G ${KOHA_GROUP} -s /bin/bash ${KOHA_USER} && \
    mkdir -p \
        /kohadevbox \
        /etc/koha/sites/${KOHASITE} \
        /etc/koha/log4perl \
        /var/log/koha/${KOHASITE} \
        /var/run/koha/${KOHASITE} \
        /var/lib/koha/${KOHASITE}/plugins \
        /var/lock/koha/${KOHASITE} \
        /opt/koha-perl \
        /etc/koha/searchengine && \
    chown -R ${KOHA_USER}:${KOHA_GROUP} \
        /etc/koha /var/log/koha /var/run/koha /var/lib/koha /var/lock/koha /kohadevbox /opt/koha-perl

# ---------------------------------------------------------------------------
# 3. PERL DEPENDENCIES - Use local::lib in /opt/koha-perl
#    We install the heavy ones via apk where possible, rest via cpanm
# ---------------------------------------------------------------------------
USER ${KOHA_USER}
WORKDIR /kohadevbox

# Clone Koha if not mounted (cached layer)
RUN git clone --depth 1 --branch main https://gitlab.com/koha-community/Koha.git koha || (cd koha && git pull --ff-only || true)

# Install cpanm deps - with cache
# First, install fast pure-perl modules that are always needed
RUN cpanm --notest --local-lib=/opt/koha-perl \
    Plack \
    Starman \
    Starlet \
    Plack::Middleware::ReverseProxy \
    Plack::Middleware::Session \
    Plack::Middleware::Debug \
    Twiggy \
    AnyEvent \
    Server::Starter

# Install Koha's full dependency list from cpanfile (may take 15-25 min first build)
# We do it in two steps: without test for speed, and allow failure for optional XS
RUN cd /kohadevbox/koha && \
    cpanm --notest --local-lib=/opt/koha-perl --installdeps . || echo "Some optional deps failed, continuing..." && \
    # Install extra Koha-specific modules that often missing
    cpanm --notest --local-lib=/opt/koha-perl \
        Modern::Perl \
        CGI \
        CGI::Session \
        CGI::Compile \
        CGI::Emulate::PSGI \
        DBD::mysql \
        DBIx::Class \
        DBIx::Class::Schema::Loader \
        DateTime \
        DateTime::Format::MySQL \
        DateTime::Format::DateParse \
        DateTime::Format::ISO8601 \
        Email::Stuffer \
        Template \
        Template::Plugin::JSON \
        Mojolicious \
        Mojolicious::Plugin::OpenAPI \
        OpenAPI::Modern \
        YAML::XS \
        JSON::Validator \
        Search::Elasticsearch \
        Cache::Memcached::Fast \
        Net::Z3950::ZOOM \
        MARC::Record \
        MARC::File::XML \
        MARC::Charset \
        Biblio::EndnoteStyle \
        Text::CSV \
        Text::CSV_XS \
        PDF::API2 \
        GD \
        GD::Barcode \
        Chart::Clicker \
        Carp::Clan \
        Memoize::Memcached \
        CHI \
        CHI::Driver::Memcached \
        Locale::PO \
        Date::Manip \
        Gravatar::URL \
        SMS::Send \
        Business::ISBN \
        Algorithm::CheckDigits \
        Net::LDAP \
        Net::OAuth2::AuthorizationServer \
        Crypt::JWT \
        JSON::WebToken \
        Net::Z3950::ZOOM || true

# Build JS assets (Koha uses webpack)
RUN cd /kohadevbox/koha && \
    yarn install || npm install && \
    yarn build || npm run build || echo "Asset build skipped"

# Switch back to root
USER root

# ---------------------------------------------------------------------------
# 4. COPY CONFIGURATION TEMPLATES AND SCRIPTS
# ---------------------------------------------------------------------------
COPY --chown=${KOHA_USER}:${KOHA_GROUP} scripts/run.sh /usr/local/bin/run.sh
COPY --chown=${KOHA_USER}:${KOHA_GROUP} scripts/koha-create-superlibrarian.sh /usr/local/bin/koha-create-superlibrarian.sh
COPY --chown=${KOHA_USER}:${KOHA_GROUP} config/koha-conf.xml.template /etc/koha/koha-conf.xml.template
COPY --chown=${KOHA_USER}:${KOHA_GROUP} config/log4perl.conf.template /etc/koha/log4perl.conf.template
COPY --chown=${KOHA_USER}:${KOHA_GROUP} config/queryparser.yaml /etc/koha/searchengine/queryparser.yaml

RUN chmod +x /usr/local/bin/run.sh /usr/local/bin/koha-create-superlibrarian.sh && \
    # Fix timezone file presence
    cp /usr/share/zoneinfo/Europe/Bucharest /etc/localtime 2>/dev/null || true && \
    echo "Europe/Bucharest" > /etc/timezone 2>/dev/null || true

# ---------------------------------------------------------------------------
# 5. FINAL SETUP
# ---------------------------------------------------------------------------
WORKDIR /kohadevbox/koha

EXPOSE 5000 5001 6001

# Healthcheck - Plack returns 302 when alive
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD wget -qO- http://127.0.0.1:5000/ | grep -q "Found\|Koha" || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["/usr/local/bin/run.sh"]
